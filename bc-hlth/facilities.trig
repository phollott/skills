#################################################################
# PROJECTION GRAPH
#
# The projection graph contains reporting views derived from the
# scene graph. It defines how reporting entities, disciplines,
# and domains are transformed into report-specific content such
# as notices, footers, legends, and rendering rules.
#################################################################

rpt:projection {

    rpt:LaboratoryReportingConfiguration
        rdfs:subClassOf holon:DataHolon .

    rpt:appliesToReportingEntity
        a rdf:Property .

    rpt:includesNotice
        a rdf:Property .

    rpt:discipline
        a rdf:Property .

    rpt:NamedQuery
        rdfs:subClassOf holon:DataHolon .

    #################################################################
    # RESOLVE FACILITY FOOTERS GIVEN REPORTING DOMAIN AND DISCIPLINE
    #################################################################

    rpt:ResolveFacilityFooters
        a rpt:NamedQuery ;
        schema:name "Resolve Facility Footers" ;
        schema:description """
    Resolves all footer notices that apply to a reporting entity through direct 
    assignment and reporting-domain inheritance.
    """ ;
        schema:text """
PREFIX plis: <http://plis.hlth.gov.bc.ca/ns#>
PREFIX rpt:  <http://plis.hlth.gov.bc.ca/reporting#>
PREFIX schema: <https://schema.org/>

SELECT DISTINCT
    ?entity
    ?entityName
    ?sourceEntity
    ?sourceName
    ?notice
    ?text
WHERE {

    VALUES (?entity) {
        (<REPORTING_ENTITY_URI>)
    }

    GRAPH <http://plis.hlth.gov.bc.ca/ns#scene> {
        ?entity
            schema:name ?entityName .

        {
            BIND(?entity AS ?sourceEntity)

            OPTIONAL {
                ?sourceEntity schema:name ?sourceName .
            }
        } UNION {
            ?entity
                plis:memberOfReportingDomain
                    ?sourceEntity .

            OPTIONAL {
                ?sourceEntity schema:name ?sourceName .
            }
        }
    }

    GRAPH <http://plis.hlth.gov.bc.ca/reporting#projection> {
        ?config
            rpt:appliesToReportingEntity
                ?sourceEntity ;
            rpt:includesNotice
                ?notice .

        ?notice
            schema:text ?text .
    }
}
ORDER BY ?sourceEntity ?notice
""" .

    #################################################################
    # RESOVE REPORTING DOMAIN GIVEN FACILITY OID AND ID
    #################################################################

    rpt:ResolveReportingDomain
        a rpt:NamedQuery ;
        schema:name "Resolve Reporting Domain" ;
        schema:description """
Resolves a reporting domain from an HL7 II root/extension pair.
The root corresponds to the reporting identifier system (OID)
and the extension corresponds to a reporting code.
""" ;
        schema:text """
PREFIX plis:   <http://plis.hlth.gov.bc.ca/ns#>
PREFIX schema: <https://schema.org/>

SELECT DISTINCT
    ?reportingDomain
    ?domainName
    ?organization
    ?organizationName
WHERE {

    VALUES (?root ?extension) {
        ("<IDENTIFIER_ROOT>" "<IDENTIFIER_EXTENSION>")
    }

    GRAPH <http://plis.hlth.gov.bc.ca/ns#scene> {

        #########################################################
        # Pattern 1:
        # Reporting code belongs directly to the reporting domain
        #########################################################

        {
            ?reportingDomain
                a plis:ReportingDomain ;
                plis:identifierSystem ?identifierSystem ;
                plis:reportingCode ?extension ;
                schema:memberOf ?organization .
        }

        UNION

        #########################################################
        # Pattern 2:
        # Reporting code belongs to a facility/entity that
        # participates in a reporting domain
        #########################################################

        {
            ?facility
                plis:reportingCode ?extension ;
                plis:memberOfReportingDomain ?reportingDomain .

            ?reportingDomain
                a plis:ReportingDomain ;
                plis:identifierSystem ?identifierSystem ;
                schema:memberOf ?organization .
        }

        ?identifierSystem
            schema:identifier ?root .

        OPTIONAL {
            ?reportingDomain
                schema:name ?domainName .
        }

        OPTIONAL {
            ?organization
                schema:name ?organizationName .
        }
    }
}
ORDER BY ?domainName""" .

    rpt:ResolveReportingFooters
        a rpt:NamedQuery ;
        schema:name "Resolve Reporting Footers" ;
        schema:description """
Returns all notices applicable to a reporting domain and discipline combination.
""" ;
        schema:text """
PREFIX plis:   <http://plis.hlth.gov.bc.ca/ns#>
PREFIX rpt:    <http://plis.hlth.gov.bc.ca/reporting#>
PREFIX schema: <https://schema.org/>

SELECT DISTINCT
    ?notice
    ?text
WHERE {

    VALUES (?reportingDomain ?discipline) {
        (<REPORTING_DOMAIN_URI> <DISCIPLINE_URI>)
    }

    GRAPH <http://plis.hlth.gov.bc.ca/reporting#projection> {

        {
            ?config
                rpt:appliesToReportingEntity ?reportingDomain ;
                rpt:discipline ?discipline ;
                rpt:includesNotice ?notice .
        }
        UNION
        {
            ?config
                rpt:appliesToReportingEntity ?reportingDomain ;
                rpt:includesNotice ?notice .

            FILTER NOT EXISTS {
                ?config rpt:discipline ?anyDiscipline
            }
        }

        ?notice
            schema:text ?text .
    }
}
ORDER BY ?notice
""" .

    rpt:ReportingDomainLookup
        a rpt:NamedQuery ;
        schema:name "Reporting Domain Lookup" ;
        schema:description """
Returns all reporting domains and reporting codes. For testing.
    """ ;
        schema:text """
PREFIX plis: <http://plis.hlth.gov.bc.ca/ns#>
PREFIX schema: <https://schema.org/>

SELECT ?reportingDomain ?name ?code
WHERE {
  GRAPH <http://plis.hlth.gov.bc.ca/ns#scene> {
      ?reportingDomain a plis:ReportingDomain ;
              schema:name ?name .

      OPTIONAL {
          ?reportingDomain plis:reportingCode ?code
      }
  }
}
ORDER BY ?name
""" .

    #############################################################
    # REUSABLE NOTICES: PHSA
    #############################################################

    rpt:PHSAAvailabilityNotice
        a holon:DataHolon ;
        schema:text """
Results performed at PHSA Laboratories unless
otherwise indicated.

For inquiries call
1-877-PHSA LAB (1-877-747-2522)
or fax 604-708-8027.
""" .

    rpt:PHSAMicrobiologyLegend
        a holon:DataHolon ;
        schema:text """
* Microbiology Susceptibility Grid
indicates comment printed below grid.
""" .


    rpt:PHSAGeneralChemistryLegend
        a holon:DataHolon ;
        schema:text """
H/L/A = Abnormal
HH/LL/AA = Critical
""" .

    rpt:NBSScreeningNotice
        a holon:DataHolon ;
        schema:text """
Newborn screening is not a diagnostic test and
all positive screens must be confirmed by
follow-up testing.

There is also a possibility of false positive
and false negative results.

Any infant with clinical features suggestive
of the disorders listed above should be
investigated regardless of the screening results.

For additional information see:
www.newbornscreeningbc.ca
""" .

