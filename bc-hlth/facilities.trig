@prefix plis: <http://plis.hlth.gov.bc.ca/ns#> .
@prefix rpt: <http://plis.hlth.gov.bc.ca/reporting#> .
@prefix holon: <http://holon.org/ns#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .

#################################################################
# Healthcare Enterprise Location and Service Delivery Holon Graph
# For integration, FHIR alignment, OpInt, and AI grounding
# Scene Graph:  What exists?
# Event Graph:  What happened?
# Projection:   How is it presented?
# Boundary:     How does it integrate?
#################################################################

#################################################################
# SCENE GRAPH
# Hospitals and Health Centres are modeled as composite
# reporting entities that may simultaneously represent
# organizational, operational, and physical-place concepts.
# These concerns may be separated into distinct holons in
# a future revision if additional spatial or governance
# requirements emerge.
#
# Reporting Domains
# PHSA:             plis:PHSAReportingDomain, plis:NBSReportingDomain
# Providence:       plis:PHCReportingDomain
# VCH:              plis:VHCReportingDomain, plis:STSReportingDomain
# IslandHealth:     plis:VIHACNReportingDomain
# InteriorHealth:   plis:IHReportingDomain
# FraserHealth:     plis:FHReportingDomain
# NorthernHealth:   plis:NHReportingDomain
# LifeLabs: plis:BCBReportingDomain, plis:LifeLabsReportingDomain, plis:VMLKReportingDomain
#           plis:VMLOReportingDomain, plis:VMLPReportingDomain, plis:VMLVReportingDomain
#################################################################

plis:scene {

    plis:ReportingEntity
        a rdfs:Class ;
        rdfs:subClassOf
            holon:Holon .

    plis:ReportingDomain
        a rdfs:Class ;
        rdfs:subClassOf
            holon:dataHolon .

    plis:memberOfReportingDomain
        a rdf:Property ;
        rdfs:domain plis:ReportingEntity ;
        rdfs:range plis:ReportingDomain .

    plis:identifierSystem
        a rdf:Property .

    plis:reportingCode
        a rdf:Property .

    #############################################################
    # REPORTING ENTITY TYPES
    #############################################################

    plis:Hospital
        a rdfs:Class ;
        rdfs:subClassOf
            plis:ReportingEntity .

    plis:HealthCentre
        a rdfs:Class ;
        rdfs:subClassOf
            plis:ReportingEntity .

    plis:LaboratoryService
        a rdfs:Class ;
        rdfs:subClassOf
            plis:ReportingEntity .

    plis:ClinicalProgram
        a rdfs:Class ;
        rdfs:subClassOf
            plis:ReportingEntity .

    #############################################################
    # DISCIPLINES
    #############################################################

    plis:Discipline
        a rdfs:Class .

    plis:GeneralChemistry
        a plis:Discipline ;
        schema:name "General Chemistry" .

    plis:Microbiology
        a plis:Discipline ;
        schema:name "Microbiology" .

    plis:AnatomicPathology
        a plis:Discipline ;
        schema:name "Anatomic Pathology" .

    #############################################################
    # ORGANIZATIONS AND IDENTIFIER SYSTEMS (OIDS)
    # The pair (identifierSystem, reportingCode) is logically equivalent
    # to an HL7 v3 II (root, extension) identifier. This may be modeled
    # explicitly in a future revision of the ontology.
    #############################################################

    plis:PHSA
        a holon:OrganizationHolon ;
        schema:name "Provincial Health Services Authority" ;
        plis:identifierSystem 
            plis:PHSAIdentifierSystem ,
            plis:PHSANewbornScreeningIdentifierSystem.

    plis:PHSAIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.301.1.62" .

    plis:PHSANewbornScreeningIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.301.10.62" .

    plis:InteriorHealth
        a holon:OrganizationHolon ;
        schema:name "Interior Health" ;
        plis:identifierSystem plis:InteriorHealthIdentifierSystem .

    plis:InteriorHealthIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.277.1.62" .

    plis:NorthernHealth
        a holon:OrganizationHolon ;
        schema:name "Northern Health" ;
        plis:identifierSystem plis:NorthernHealthIdentifierSystem .

    plis:NorthernHealthIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.523.1.62" .

    plis:FraserHealth
        a holon:OrganizationHolon ;
        schema:name "Fraser Health" ;
        plis:identifierSystem plis:FraserHealthIdentifierSystem .

    plis:FraserHealthIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.784.1.62" .

    plis:IslandHealth
        a holon:OrganizationHolon ;
        schema:name "Vancouver Island Health Authority" ;
        plis:identifierSystem plis:IslandHealthIdentifierSystem .

    plis:IslandHealthIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.851.1.62" .

    plis:VancouverCoastalHealth
        a holon:OrganizationHolon ;
        schema:name "Vancouver Coastal Health" ;
        plis:identifierSystem 
            plis:VancouverCoastalIdentifierSystemA ,
            plis:VancouverCoastalIdentifierSystemB .

    plis:VancouverCoastalIdentifierSystemA
        schema:identifier
            "2.16.840.1.113883.3.1343.1.62" .

    plis:VancouverCoastalIdentifierSystemB
        schema:identifier
            "2.16.840.1.113883.3.1343.2.62" .

    plis:ProvidenceHealthCare
        a holon:OrganizationHolon ;
        schema:name "Providence Health Care" ;
        plis:identifierSystem plis:ProvidenceHealthcareIdentifierSystem .

    plis:ProvidenceHealthcareIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.1343.1.62" .

    plis:LifeLabs
        a holon:OrganizationHolon ;
        schema:name "LifeLabs" ;
        plis:identifierSystem
            plis:LifeLabsIdentifierSystem .

    plis:LifeLabsIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.1772.1.62" .

    plis:CanadianBloodServices
        a holon:OrganizationHolon ;
        schema:name "Canadian Blood Services" ;
        plis:identifierSystem
            plis:CanadianBloodServicesIdentifierSystem .

    plis:CanadianBloodServicesIdentifierSystem
        schema:identifier
            "2.16.840.1.113883.3.3565.1.62" .

    #############################################################
    # PHSA REPORTING DOMAINS
    #############################################################

    plis:PHSAReportingDomain
        a plis:ReportingDomain ;
        schema:name "PHSA Reporting Domain" ;
        schema:memberOf plis:PHSA ;
        plis:reportingCode "CDC" ;
        plis:reportingCode "BCC" ;
        plis:reportingCode "CWH" ;
        plis:reportingCode "PHSA-SQ" ;
        plis:identifierSystem
            plis:PHSAIdentifierSystem .

    plis:NBSReportingDomain
        a plis:ReportingDomain ;
        schema:name "NBS Reporting Domain" ;
        schema:memberOf plis:PHSA ;
        plis:reportingCode "NBSLab" ;
        plis:identifierSystem
            plis:PHSANewbornScreeningIdentifierSystem .

    #############################################################
    # VANCOUVER COASTAL / PROVIDENCE REPORTING DOMAINS
    #############################################################

    plis:PHCReportingDomain
        a plis:ReportingDomain ;
        schema:name "Providence Health Care Reporting Domain" ;
        schema:memberOf plis:ProvidenceHealthCare ;
        plis:reportingCode "PHC" ;
        plis:identifierSystem
            plis:VancouverCoastalIdentifierSystemA ,
            plis:VancouverCoastalIdentifierSystemB .

    plis:VHCReportingDomain
        a plis:ReportingDomain ;
        schema:name "Vancouver Coastal Health Reporting Domain" ;
        schema:memberOf plis:VancouverCoastalHealth ;
        plis:reportingCode "VHC" ;
        plis:identifierSystem
            plis:VancouverCoastalIdentifierSystemB .

    plis:STSReportingDomain
        a plis:ReportingDomain ;
        schema:name "Sea-to-Sky Reporting Domain" ;
        schema:memberOf plis:VancouverCoastalHealth ;
        plis:reportingCode "STS" ;
        plis:identifierSystem
