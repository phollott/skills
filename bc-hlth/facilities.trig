#################################################################
# BOUNDARY GRAPH
#
# External representations, integration mappings,
# source-system provenance, HL7 identifiers,
# FHIR resource mappings, terminology alignments,
# and interoperability contracts.
#################################################################

plis:boundary {

    plis:HL7InstanceIdentifier
        a rdfs:Class .

    plis:mapsToHL7Root
        a rdf:Property .

    plis:mapsToHL7Extension
        a rdf:Property .

    plis:ReportDomain
        plis:derivedFromTable
            "FACILITY_LOOKUP" .

    plis:reportingCode
        plis:derivedFromColumn
            "FACILITY_ID" .

    plis:identifierSystem
        plis:derivedFromColumn
            "FACILITY_OID" .

}
