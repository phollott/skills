#################################################################
# EVENT GRAPH
#
# The source system does not explicitly model event. However,
# some projection artefacts contain temporal assertions from
# which historical events may be inferred.
#################################################################

#################################################################
# EVENT GRAPH
#
# The Event graph currently contains only events that can be
# directly inferred from available source artefacts.
#
# These events represent changes in reporting availability and
# help explain how the current reporting landscape came  to be.
#
# Additional onboarding and facility activation events may be
# added as historical implementation records become available.
#################################################################

plis:event {

    plis:Event
        a rdfs:Class ;
        rdfs:subClassOf holon:EventHolon .

    plis:AvailabilityEvent
        a rdfs:Class ;
        rdfs:subClassOf plis:Event .

    plis:ReportingAvailabilityEvent
        a rdfs:Class ;
        rdfs:subClassOf plis:AvailabilityEvent .

    plis:subject
        a rdf:Property .

    plis:effectiveDate
        a rdf:Property .

    plis:affectedDiscipline
        a rdf:Property .

    #############################################################
    # INTERIOR HEALTH
    #############################################################

    plis:IHClinicalLaboratoryAvailability
        a plis:ReportingAvailabilityEvent ;

        schema:name
            "Interior Health Clinical Laboratory Reporting Available" ;

        plis:subject
            plis:IHReportingDomain ;

        plis:effectiveDate
            "2010-05-15"^^xsd:date ;

        schema:description
            """
IHA lab data for Chemistry, Hematology, Microbiology and Blood Bank
results became available through PLIS/eViewer.
""" .

    plis:IHAnatomicPathologyAvailability
        a plis:ReportingAvailabilityEvent ;

        schema:name
            "Interior Health Anatomic Pathology Reporting Available" ;

        plis:subject
            plis:IHReportingDomain ;

        plis:affectedDiscipline
            plis:AnatomicPathology ;

        plis:effectiveDate
            "2012-04-18"^^xsd:date ;

        schema:description
            """
IHA lab data for Anatomic Pathology results became available
through PLIS/eViewer.
""" .

    #############################################################
    # OTHER REPORTING DOMAINS CAN BE ADDED WITH DATES TO SUPPORT
