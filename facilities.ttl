        schema:memberOf plis:InteriorHealth ;
        plis:reportingCode "IHPCP" ;
        plis:reportingCode "IHPCM" ;
        plis:reportingCode "IHPCN" .

}

#################################################################
# PROJECTION GRAPH
#################################################################

rpt:projection {

    rpt:LaboratoryReportingConfiguration
        a rdfs:Class . 
    
    rpt:NamedQuery
        a rdfs:Class .

#################################################################
# REPORTING QUERIES (BY FACILITY AND DISCIPLINE)
# Will not work for VHC/STS/PHC domains because they are not 
# facilities and the query requires:
#   ?facility schema:memberOf ?organization
#################################################################

    rpt:FacilityDisciplineFooterLookup
        a rpt:NamedQuery ;
        schema:name "Facility Discipline Footer Lookup" ;
        schema:description """
Returns all reporting notices applicable to a
facility and discipline combination.
""" ;
        schema:text """
PREFIX plis: <http://plis.hlth.gov.bc.ca/ns#>
PREFIX rpt:  <http://plis.hlth.gov.bc.ca/reporting#>
PREFIX schema: <https://schema.org/>

SELECT ?notice ?text
WHERE {

    VALUES (?facility ?discipline) {
       (<FACILITY_URI> <DISCIPLINE_URI>)
    }

    {
        ?facility schema:memberOf ?organization .

        ?config
            rpt:appliesToReportingEntity ?organization ;
            rpt:discipline ?discipline ;
            rpt:includesNotice ?notice .
    }

    UNION

    {
        ?config
            rpt:appliesToReportingEntity ?facility ;
            rpt:includesNotice ?notice .
    }

    ?notice schema:text ?text .
}
""" .

    #############################################################
    # REUSABLE NOTICES: PHSA
    #############################################################

    rpt:PHSAAvailabilityNotice
        schema:text """
Results performed at PHSA Laboratories unless
otherwise indicated.

For inquiries call
1-877-PHSA LAB (1-877-747-2522)
or fax 604-708-8027.
""" .

    rpt:PHSAMicrobiologyLegend
        schema:text """
* Microbiology Susceptibility Grid
indicates comment printed below grid.
""" .


    rpt:PHSAGeneralChemistryLegend
        schema:text """
H/L/A = Abnormal
HH/LL/AA = Critical
""" .

    rpt:NBSScreeningNotice
        schema:text """
Newborn screening is not a diagnostic test and
all positive screens must be confirmed by
follow-up testing.

There is also a possibility of false positive
and false negative results.

Any infant with clinical features suggestive
of the disorders listed above should be
investigated regardless of the screening results.

For additional information see:
www.newbornscreeningbc.ca
""" .

    #############################################################
    # REUSABLE NOTICES: IHA
    #############################################################

    rpt:IHAAvailabilityNotice
