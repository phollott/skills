    rpt:VMLP-Footer
        a rpt:LaboratoryReportingConfiguration ;
        rpt:appliesToReportingEntity
            plis:VMLPReportingDomain ;
        rpt:includesNotice
            rpt:VMLPInquiryNotice .

    rpt:VMLV-Footer
        a rpt:LaboratoryReportingConfiguration ;
        rpt:appliesToReportingEntity
            plis:VMLVReportingDomain ;
        rpt:includesNotice
            rpt:VMLVInquiryNotice .

}

#################################################################
# BOUNDARY GRAPH
#################################################################

plis:boundary {

    #############################################################
    # ASSERTION STATUS VOCABULARY
    #############################################################

    plis:ObservedAssertion .
    plis:InferredAssertion .
    plis:VerifiedAssertion .

}
